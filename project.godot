[autoload]

GameManager="*res://Scripts/GameManager.gd"
DebugInspector="*res://Scripts/DebugInspector.gd"
DebugSettings="*res://Scripts/DebugSettings.gd"

[layer_names]

3d_physics/layer_2="Units"
